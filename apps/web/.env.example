# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hitechbenchmark

# Authentication (NextAuth v5)
# AUTH_SECRET is the primary env var for NextAuth v5; NEXTAUTH_SECRET also works as fallback.
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# OAuth Providers (optional — omit or leave blank to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
