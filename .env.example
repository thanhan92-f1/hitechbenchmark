# =============================================================================
# HiTech Benchmark - Environment Variables Example
# Copy this file to .env and fill in the values
# =============================================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://hitechbench:password@localhost:5432/hitechbenchmark

# Redis
REDIS_URL=redis://localhost:6379

# Queue
QUEUE_CONNECTION=redis

# Security
BENCHMARK_SIGNING_SECRET=change-me-to-a-random-256-bit-hex-secret
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
# Google: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GeoIP (ip-api.com is free for non-commercial, MaxMind for production)
GEOIP_PROVIDER=ipapi
GEOIP_API_KEY=

# Cloudflare (optional)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ENABLE_HTTP3=false
TRUSTED_PROXIES=

# Admin
ADMIN_APP_URL=http://localhost:3000/admin
ADMIN_ALLOWED_ROLES=super_admin,admin,moderator,support

# Upload
ADMIN_UPLOAD_MAX_SIZE=5242880

# Rate Limiting (requests per window)
RATE_LIMIT_BENCHMARK_INGEST=10
RATE_LIMIT_WINDOW_SECONDS=60

# CDN
CDN_URL=
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HiTech Benchmark
