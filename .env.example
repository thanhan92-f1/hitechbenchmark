# =============================================================================
# HiTech Benchmark - Single Root Environment Template
# Copy this file to .env. Do not create apps/web/.env* or apps/worker/.env*.
# =============================================================================

# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
CERTBOT_EMAIL=

# PostgreSQL
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://hitechbench:password@localhost:5432/hitechbenchmark

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_CONNECTION=redis

# Auth / security
# Generate production secrets with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret
AUTH_SECRET=change-me-to-a-random-secret
BENCHMARK_SIGNING_SECRET=change-me-to-a-random-256-bit-hex-secret

# Public app URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_SITE_NAME=HiTech Benchmark
SCRIPT_VERSION=1.0.0

# OAuth providers (optional)
# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email / SMTP (optional)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=false
EMAIL_FROM="HiTech Benchmark <noreply@hitechbenchmark.com>"

# WebAuthn / Passkeys (optional)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# AI analysis provider (worker)
# Options: anthropic | openai | azure | groq | together | ollama | lmstudio | disabled
AI_PROVIDER=disabled
AI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=1024
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# GeoIP (optional)
GEOIP_PROVIDER=ipapi
GEOIP_API_KEY=

# Cloudflare / proxy (optional)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ENABLE_HTTP3=false
TRUSTED_PROXIES=

# Admin
ADMIN_APP_URL=http://localhost:3000/admin
ADMIN_ALLOWED_ROLES=super_admin,admin,moderator,support
ADMIN_UPLOAD_MAX_SIZE=5242880

# Rate limiting
RATE_LIMIT_BENCHMARK_INGEST=10
RATE_LIMIT_WINDOW_SECONDS=60

# CDN / analytics / error tracking (optional)
CDN_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
