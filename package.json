{
  "name": "hitechbenchmark",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "start": "dotenv -e .env -- pnpm --filter @hitechbenchmark/web start",
    "start:worker": "dotenv -e .env -- pnpm --filter @hitechbenchmark/worker start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @hitechbenchmark/db run db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @hitechbenchmark/db exec prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env -- pnpm --filter @hitechbenchmark/db exec prisma migrate deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @hitechbenchmark/db exec tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env -- pnpm --filter @hitechbenchmark/db exec prisma studio",
    "docker:dev": "docker compose up -d database",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
